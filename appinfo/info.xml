<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>library</id>
    <name>Library</name>
    <summary>Publication catalogue for files stored in Nextcloud Files</summary>
    <description><![CDATA[Library adds a publication-specific catalogue, metadata cleanup workflow, search and browsing interface on top of ordinary Nextcloud files. Source files remain canonical in Nextcloud Files; Library stores app-owned indexes, extracted metadata and user edits. Create private reading lists with notes, infer metadata from filenames and paths with preview and reversible approval, review potential duplicates, and schedule incremental scans. In this development version, you can explicitly look up book details from Open Library and share a shelf read-only with another Nextcloud user. Library does not provide a built-in reader. This version targets Nextcloud 33–35.]]></description>
    <version>0.4.0-alpha.5</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Library contributors</author>
    <namespace>Library</namespace>
    <category>files</category>
    <category>multimedia</category>
    <website>https://github.com/utrost/Library</website>
    <bugs>https://github.com/utrost/Library/issues</bugs>
    <repository type="git">https://github.com/utrost/Library</repository>
    <screenshot>https://raw.githubusercontent.com/utrost/Library/v0.3.0/docs/images/appstore-catalogue.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/utrost/Library/v0.3.0/docs/images/appstore-details.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/utrost/Library/v0.3.0/docs/images/appstore-authors.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/utrost/Library/v0.3.0/docs/images/appstore-inference.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/utrost/Library/v0.3.0/docs/images/appstore-inference-worklist.png</screenshot>
    <dependencies>
        <database>sqlite</database>
        <database>mysql</database>
        <database>pgsql</database>
        <nextcloud min-version="33" max-version="35" />
    </dependencies>
    <repair-steps>
        <install>
            <step>OCA\Library\Migration\EnableSharing</step>
        </install>
        <uninstall>
            <step>OCA\Library\Migration\RevokeManagedShares</step>
        </uninstall>
    </repair-steps>
    <background-jobs>
        <job>OCA\Library\BackgroundJob\MetadataLookupJob</job>
        <job>OCA\Library\BackgroundJob\ScheduledScanJob</job>
        <job>OCA\Library\BackgroundJob\MaintenanceJob</job>
        <job>OCA\Library\BackgroundJob\AuthorBackfillJob</job>
        <job>OCA\Library\BackgroundJob\AuthorOperationJob</job>
        <job>OCA\Library\BackgroundJob\SeriesBackfillJob</job>
        <job>OCA\Library\BackgroundJob\GenreDiscoveryJob</job>
        <job>OCA\Library\BackgroundJob\LanguageReviewJob</job>
        <job>OCA\Library\BackgroundJob\SearchIndexBackfillJob</job>
    </background-jobs>
    <commands>
        <command>OCA\Library\Command\RebuildFacetIndex</command>
        <command>OCA\Library\Command\RebuildSearchIndex</command>
        <command>OCA\Library\Command\MigrateAuthors</command>
    </commands>
    <settings>
        <admin>OCA\Library\Settings\Admin</admin>
        <admin-section>OCA\Library\Settings\PersonalSection</admin-section>
        <personal>OCA\Library\Settings\Personal</personal>
        <personal-section>OCA\Library\Settings\PersonalSection</personal-section>
    </settings>
    <navigations>
        <navigation>
            <name>Library</name>
            <route>library.page.index</route>
            <icon>app.svg</icon>
            <order>8</order>
        </navigation>
    </navigations>
</info>
